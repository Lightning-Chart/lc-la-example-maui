<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>LightningChartMauiExample</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <WindowsPackageType>None</WindowsPackageType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
  </ItemGroup>
  <PropertyGroup>
    <LclaSourceProject Condition="'$(LclaSourceProject)' == ''">..\..\packages\clients\csharp\LightningChart.LA\LightningChart.LA.csproj</LclaSourceProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(LclaUseLocalSource)' != 'true'">
    <PackageReference Include="LCLA" Version="0.0.9" />
  </ItemGroup>
  <ItemGroup Condition="'$(LclaUseLocalSource)' == 'true'">
    <ProjectReference Include="$(LclaSourceProject)" />
  </ItemGroup>
</Project>
